# Copy to .env on the server and enter this website's actual values.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://wisdomnews.in
APP_NAME="Wisdom News"
APP_TIMEZONE=Asia/Kolkata

SESSION_SECURE=true
SESSION_LIFETIME=7200

# Use the new application database created in hPanel, separate from WordPress.
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=replace_with_hpanel_database_name
DB_USERNAME=replace_with_hpanel_database_user
DB_PASSWORD=
DB_PERSISTENT=true

# Production uploads currently use Cloudflare R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_REGION=auto

# Leave blank on Hostinger unless a server-specific CA bundle is needed.
CA_BUNDLE_PATH=
